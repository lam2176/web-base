# Application
NODE_ENV=development
PORT=3027
API_PREFIX=api

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop_dev
# For local development with Docker Compose
# These are used by docker-compose.dev.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shop_dev
POSTGRES_PORT=5432
ADMINER_PORT=8080

# JWT - Legacy (fallback for both admin and customer if specific secrets not set)
JWT_SECRET=your-super-secret-key-change-this-in-production

# Admin JWT (for admin/staff authentication)
ADMIN_JWT_SECRET=your-admin-secret-key-change-this-in-production
ADMIN_JWT_ACCESS_TOKEN_EXPIRY=3h
ADMIN_JWT_REFRESH_TOKEN_EXPIRY=7d

# Customer JWT (for customer authentication)
CUSTOMER_JWT_SECRET=your-customer-secret-key-change-this-in-production
CUSTOMER_JWT_ACCESS_TOKEN_EXPIRY=7d
CUSTOMER_JWT_REFRESH_TOKEN_EXPIRY=30d

# SMTP Email Configuration
# Leave these empty to disable email sending (emails will be logged only)
# For Gmail:
#   1. Enable 2-factor authentication in your Google account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Use the generated 16-character password as SMTP_PASS
#
# Port options:
#   - 587: Use with STARTTLS (recommended for most providers)
#   - 465: Use with SSL (set secure=true)
#   - 25: Standard SMTP port (usually blocked by ISPs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=NextShop
SMTP_FROM_EMAIL=noreply@yourshop.com

# Admin Email Addresses (comma-separated for multiple admins)
# These emails will receive notifications for new orders and important events
ADMIN_EMAILS=admin@yourshop.com,manager@yourshop.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Supabase Storage Configuration (Custom Authentication)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
